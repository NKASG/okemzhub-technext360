{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "okemzhub-technext360",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["python_workers"],

  // The frontend (index.html, /static/...) is served directly by Cloudflare.
  // Asset requests are free and never run the Python code; anything that is
  // not a file in ./frontend (the API) goes to worker.py.
  "assets": {
    "directory": "./frontend"
  },

  // Postgres via Hyperdrive. Create the config in the Cloudflare dashboard
  // (Storage & Databases > Hyperdrive) and paste its ID here.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "161139134b004b958728cd6ae5c318d1"
    }
  ],

  // Run the Worker next to the database (Render Postgres, Ohio = AWS us-east-2)
  // instead of next to the visitor. Each page makes many sequential queries,
  // so this turns ~200 ms per query (Lagos <-> Ohio) into ~1-3 ms.
  "placement": {
    "region": "aws:us-east-2"
  },

  // Vendored packages: skip compiled caches to keep the upload small.
  "python_modules": {
    "exclude": ["**/*.pyc", "**/__pycache__"]
  },

  "observability": {
    "enabled": true
  }
}
